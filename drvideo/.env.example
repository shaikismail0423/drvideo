# Copy this file to .env and fill in your server's details.
BASE_URL=http://your-server:8000/v1
API_KEY=your-api-key
MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Optional: an embedding model on the same server, for retrieval.
# Leave empty to use keyword similarity instead.
EMBED_MODEL=

# Optional: the model's context window in tokens (only used for a warning).
CONTEXT_TOKENS=32000
